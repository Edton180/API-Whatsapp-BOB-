# API WhatsApp BOB - copie para .env e ajuste.

# Porta HTTP
SERVER_PORT=8080
# Chave global (crie uma longa e aleatória: openssl rand -hex 24)
GLOBAL_API_KEY=troque-esta-chave

# Banco. Em branco, a BOB usa SQLite na pasta DATA_DIR (bom para testes e servidores pequenos).
# Em produção com muitos números, prefira PostgreSQL:
# POSTGRES_AUTH_DB=postgresql://bob:senha@localhost:5432/bob_auth?sslmode=disable
# POSTGRES_USERS_DB=postgresql://bob:senha@localhost:5432/bob_users?sslmode=disable
DATA_DIR=dbdata

# Como o aparelho aparece em "Aparelhos conectados" no celular
OS_NAME=API WhatsApp BOB
CLIENT_NAME=bob

# Reconectar sozinho os números já conectados quando a API iniciar
CONNECT_ON_STARTUP=true
# Mandar a mídia recebida (base64) dentro do webhook
WEBHOOK_FILES=true
# Guardar o histórico de mensagens e conversas no banco
STORE_MESSAGES=true
# Apagar do histórico mensagens com mais de N dias (0 = guardar para sempre)
STORE_MESSAGES_DAYS=0
# Reconectar (sem QR Code) números "conectados" sem nenhum evento há N horas (0 = desliga)
RECONNECT_IDLE_HOURS=6
# Webhook padrão para instâncias sem webhook próprio (opcional)
WEBHOOK_URL=
# Ignorar eventos de grupos e de status para todas as instâncias
EVENT_IGNORE_GROUP=false
EVENT_IGNORE_STATUS=true
# Quantos QR Codes gerar antes de desistir (cada um vale ~20 s)
QRCODE_MAX_COUNT=5
# Confirmar o número no WhatsApp antes de enviar (corrige o nono dígito)
CHECK_USER_EXISTS=true
# Painel web em /painel/
PANEL_ENABLED=true
# Nível de log da biblioteca do WhatsApp: DEBUG, INFO, WARN, ERROR
WADEBUG=WARN

# Proxy padrão (opcional). PROXY_PROTOCOL: http, https ou socks5
# PROXY_PROTOCOL=http
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=
